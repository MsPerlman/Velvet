    <Button Name="SuccessRestartButton" X="-24" Y="-16" Width="168" Height="44" TabStop="yes" FontId="1" ImageFile="b-redemarrer.png" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
  </Page>

